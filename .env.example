# Copy to .env.local and fill. Server-side only — never prefix with VITE_.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Decisions models only: POST {model,state,questions}. Chat completions 400s for them.
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.14

# Client-visible (safe) — required only once the real backend exists.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
